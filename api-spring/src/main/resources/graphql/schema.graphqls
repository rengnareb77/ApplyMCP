type Query {
    getPerson(id: ID!): Person
    getFirstProfile: Person
}

type Mutation {
    updatePerson(id: ID!, input: PersonInput!): Person

    addWorkExperience(profileId: ID!, input: WorkExperienceInput!): Person
    removeWorkExperience(profileId: ID!, index: Int!): Person
    updateWorkExperience(profileId: ID!, index: Int!, input: WorkExperienceInput!): Person

    addEducation(profileId: ID!, input: EducationInput!): Person
    removeEducation(profileId: ID!, index: Int!): Person
    updateEducation(profileId: ID!, index: Int!, input: EducationInput!): Person

    addProject(profileId: ID!, input: ProjectInput!): Person
    removeProject(profileId: ID!, index: Int!): Person
    updateProject(profileId: ID!, index: Int!, input: ProjectInput!): Person
}

# --- TYPES ---

type Person {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    birthDate: String
    phoneNumber: String
    address: String
    linkedinUrl: String
    githubUrl: String
    portfolioUrl: String
    summary: String
    hobbies: [String]
    languages: [String]
    projects: [Project]
    educations: [Education]
    workExperiences: [WorkExperience]
    skills: [String!]!
}

type Skill {
    type: String
    name: String
}

type WorkExperience {
    company: String!
    role: String!
    startDate: String!
    endDate: String
    location: String
    contractType: String
    description: String
    achievement: String
    skills: [Skill]
}

type Education {
    institution: String!
    description: String
    degree: String
    location: String
    startDate: String
    endDate: String
}
type Project {
    title: String!
    description: String
    year: String
    repositoryUrl: String
    liveDemoUrl: String
    skills: [Skill]
}


# --- INPUTS (Pour les mutations) ---

input PersonInput {
    firstName: String
    lastName: String
    email: String
    birthDate: String
    phoneNumber: String
    address: String
    linkedinUrl: String
    githubUrl: String
    portfolioUrl: String
    summary: String
    hobbies: [String]
    languages: [String]
}

input WorkExperienceInput {
    company: String!
    role: String!
    startDate: String!
    endDate: String
    location: String
    contractType: String
    description: String
    achievement: String
    skills: [SkillInput]
}

input SkillInput {
    type: String
    name: String
}

input EducationInput {
    institution: String!
    description: String
    degree: String
    location: String
    startDate: String
    endDate: String
}

input ProjectInput {
    title: String!
    description: String
    repositoryUrl: String
    liveDemoUrl: String
    skills: [SkillInput]
    year: String
}